# ZollTax configuration. Copy to .env (gitignored).
#
# The web app (src/server.js) is now MULTI-TENANT: each client logs in and sets
# their own integration keys through the in-app Settings page, stored encrypted
# under data/clients/. The only server-level settings live here. The integration
# keys further down are LEGACY — used only by the one-shot CLI (src/index.js),
# not by the web app.

# ── Web server ──────────────────────────────────────────────────────────────
PORT=4000
# Send the session cookie only over HTTPS (set to 1 behind a TLS proxy in prod).
# ZOLLTAX_SECURE_COOKIE=1
# Override where accounts + encrypted client configs are stored (default ./data).
# ZOLLTAX_DATA_DIR=

# ── Hardening ───────────────────────────────────────────────────────────────
# Trust X-Forwarded-For for the real client IP (rate limiting). Enable ONLY when
# a reverse proxy actually fronts the app, or clients could spoof their IP.
# ZOLLTAX_TRUST_PROXY=1
# Per-client-IP request caps per minute: overall, and for login/setup (tighter).
# ZOLLTAX_RATE_MAX=300
# ZOLLTAX_AUTH_RATE_MAX=15
# Max request body in bytes (default 8 MB; booking payloads carry a base64 PDF).
# ZOLLTAX_MAX_BODY=8388608

# ── Auth + encryption ───────────────────────────────────────────────────────
# On FIRST RUN you can leave all of these blank: open the app and the setup
# wizard creates the admin account and generates + saves ZOLLTAX_MASTER_KEY here
# for you. Set them by hand only for headless/automated provisioning.
#
# 32-byte key that encrypts every client's stored secrets at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/changing this makes all stored client configs unreadable.
# ZOLLTAX_MASTER_KEY=
# Signs session cookies (any long random string). Defaults to the master key.
# ZOLLTAX_SESSION_SECRET=
# Seeds the first admin instead of using the wizard (empty store, first boot only).
# ZOLLTAX_ADMIN_EMAIL=you@example.com
# ZOLLTAX_ADMIN_PASSWORD=pick-a-strong-password
# Override where .env itself lives (e.g. a mounted secrets file the wizard writes to).
# ZOLLTAX_ENV_FILE=

# ── Lexware Office (lexoffice) — booking vouchers (LEGACY / CLI only) ────────
LEXWARE_API_KEY=paste-your-api-key-here
# LEXWARE_API_URL=https://api.lexoffice.io/v1
# Expense account UUID for the monthly myPOS fees voucher (purchase voucher).
# Set to the lexoffice account you book payment/transaction fees against.
# LEXWARE_FEE_CATEGORY=

# ── ZollTool read API — matching clusters to events ─────────────────────────
ZOLLTOOL_URL=http://localhost:8787
# Preferred: a scoped, read-only API token (no password stored). Mint one in
# ZollTool: log in, then POST /api/tokens (owner/admin) → use the returned zt_… .
ZOLLTOOL_API_TOKEN=zt_...
# Legacy fallback (only used if no token is set):
# ZOLLTOOL_EMAIL=accounting@example.com
# ZOLLTOOL_PASSWORD=your-password

# ── myPOS Banking API — verifying clusters against live settled data ────────
# From the myPOS Partner Portal (demo: https://demo-partners.mypos.com).
# With the full set unset, myPOS verification uses mock data.
# Defaults to PRODUCTION (https://api-gateway.mypos.com) when unset — only set
# the demo gateway below for sandbox testing (live creds fail on demo).
# MYPOS_GATEWAY_URL=https://demo-api-gateway.mypos.com
MYPOS_CLIENT_ID=client_...
MYPOS_CLIENT_SECRET=secret_...
MYPOS_MERCHANT_CLIENT_ID=cli_...
MYPOS_MERCHANT_CLIENT_SECRET=sec_...
MYPOS_PARTNER_ID=mps-p-...
MYPOS_APPLICATION_ID=mps-app-...
# MYPOS_MODE=live
# MYPOS_ACCOUNT=

# ── Shopify Admin API — pull online + Shopify POS orders for a period ────────
# Create a custom app in the Shopify Dev Dashboard, grant read_orders +
# read_locations, release/install it, then copy Client ID + Secret from Settings.
# The backend exchanges these credentials for a short-lived Admin API token and
# refreshes it automatically. With Shopify credentials unset, pull uses mock data.
SHOPIFY_SHOP=mystore.myshopify.com
SHOPIFY_CLIENT_ID=client_id_...
SHOPIFY_CLIENT_SECRET=client_secret_...
# Legacy/static tokens still work if you already have one:
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_MODE=live

# -- SumUp API - pull POS/online transactions for a period -------------------
# Create an API key with transactions.history (or transactions.read). Payouts
# later need payouts.read. With SumUp credentials unset, pull uses mock data.
SUMUP_API_KEY=sumup_api_key_...
SUMUP_MERCHANT_CODE=merchant_code_...
# SUMUP_API_URL=https://api.sumup.com
# SUMUP_MODE=live