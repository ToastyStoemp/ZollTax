# Accounting bridge configuration. Copy to .env (gitignored).
# Loaded by src/config.js; the web backend (src/server.js) reads all of these.

# ── Web server ──────────────────────────────────────────────────────────────
PORT=4000

# ── Lexware Office (lexoffice) — booking vouchers ───────────────────────────
LEXWARE_API_KEY=paste-your-api-key-here
# LEXWARE_API_URL=https://api.lexoffice.io/v1
# Expense account UUID for the monthly myPOS fees voucher (purchase voucher).
# Set to the lexoffice account you book payment/transaction fees against.
# LEXWARE_FEE_CATEGORY=

# ── ZollTool read API — matching clusters to events ─────────────────────────
# Create a dedicated ZollTool account and put its login here.
ZOLLTOOL_URL=http://localhost:8787
ZOLLTOOL_EMAIL=accounting@example.com
ZOLLTOOL_PASSWORD=your-password

# ── myPOS Banking API — verifying clusters against live settled data ────────
# From the myPOS Partner Portal (demo: https://demo-partners.mypos.com).
# With the full set unset, myPOS verification uses mock data.
MYPOS_GATEWAY_URL=https://demo-api-gateway.mypos.com
MYPOS_CLIENT_ID=client_...
MYPOS_CLIENT_SECRET=secret_...
MYPOS_MERCHANT_CLIENT_ID=cli_...
MYPOS_MERCHANT_CLIENT_SECRET=sec_...
MYPOS_PARTNER_ID=mps-p-...
MYPOS_APPLICATION_ID=mps-app-...
# MYPOS_MODE=live
# MYPOS_ACCOUNT=

# ── Shopify Admin API — pull online + Shopify POS orders for a period ────────
# Create a custom app in the Shopify Dev Dashboard, grant read_orders +
# read_locations, release/install it, then copy Client ID + Secret from Settings.
# The backend exchanges these credentials for a short-lived Admin API token and
# refreshes it automatically. With Shopify credentials unset, pull uses mock data.
SHOPIFY_SHOP=mystore.myshopify.com
SHOPIFY_CLIENT_ID=client_id_...
SHOPIFY_CLIENT_SECRET=client_secret_...
# Legacy/static tokens still work if you already have one:
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_MODE=live
